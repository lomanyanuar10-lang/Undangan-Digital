rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Events collection (Public can read, authenticated admin or valid app writes)
    match /events/{eventId} {
      allow read: if true;
      allow create, update, write: if isSignedIn() || isValidId(eventId);
      allow delete: if isSignedIn();

      // RSVP subcollection for events (Tamu undangan can read and submit RSVPs)
      match /rsvps/{rsvpId} {
        allow read, create, update, write: if isValidId(eventId) && isValidId(rsvpId);
        allow delete: if isSignedIn() || isValidId(eventId);
      }

      // Stats subcollection (Visitor counter)
      match /stats/{statId} {
        allow read, write: if isValidId(eventId) && isValidId(statId);
      }
    }

    // Catch-all
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
